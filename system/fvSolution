FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{ // VOF eqn solved with MULES
    "alpha.water.*"
    {
        nCorrectors 2; // correction loop for alpha
        nSubCycles 1; //sub steps of alpha inside one flow step 
        MULESCorr yes; //semi implicit MULES
        MULES
        {
            nIter 10;
            tolerance 1e-2;
        }

        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-8;
        relTol 0;
    }

    "pcorr.*"
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-7;
        relTol 0;
    }

    // pressure eqn 
    p_rgh
    {
        solver GAMG;//multigrid
        smoother DIC;
        tolerance 1e-7;
        relTol 0.05;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol 0;
    }

    //momentum 
    "U.*"
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-8;
        relTol 0;
    }
}

PIMPLE
{
    momentumPredictor no;
    nOuterCorrectors 1;
    nCorrectors 3;// pressure correction per time step
    nNonOrthogonalCorrectors 0;// orthogonal mesh
}

relaxationFactors
{
    equations
    {
        ".*" 1; // no underrelaxation
    }
}
